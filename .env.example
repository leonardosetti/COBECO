# COBECO MVP — Variáveis de Ambiente (Template)
# Copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env real (contém segredos)

# ============================================================
# NVIDIA NIM — Modelo LLM Principal (Nemotron 3 Ultra 550B)
# Obtenha sua API key em: https://build.nvidia.com/
# ============================================================
NVIDIA_NIM_API_KEY=seu_token_nvidia_nim_aqui

# ============================================================
# GitHub — Para MCP Servers (github, github-kanban, github-remote)
# Crie um PAT em: https://github.com/settings/tokens
# Scopes necessários: repo, read:org, workflow
# ============================================================
GITHUB_TOKEN=ghp_seu_personal_access_token_aqui

# ============================================================
# Banco de Dados — MySQL 8 InnoDB (board_roadmap stack)
# Formato: mysql+pymysql://usuario:senha@host:porta/database
# ============================================================
DATABASE_URL=mysql+pymysql://cobeco:cobeco@db:3306/cobeco

# ============================================================
# Autenticação JWT — Backend FastAPI
# Gere SECRET_KEY com: openssl rand -hex 32
# ============================================================
SECRET_KEY=gere_com_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Recuperação de Senha — Modo Desenvolvimento
# Opções: "log" (token no stdout do container) ou "email" (requer SMTP)
# ============================================================
RECOVERY_MODE=log

# ============================================================
# Frontend — Servido pelo nginx proxy na porta 8380
# ============================================================
FRONTEND_ORIGIN=http://localhost:8380

# ============================================================
# Opcional — Configurações Adicionais
# ============================================================
# CORS Origins (se necessário para desenvolvimento local)
# BACKEND_CORS_ORIGINS=["http://localhost:8380","http://127.0.0.1:8380"]

# Rate Limiting (padrão: 6 req/15min por IP + username)
# RATE_LIMIT_REQUESTS=6
# RATE_LIMIT_WINDOW_MINUTES=15

# Log Level
# LOG_LEVEL=INFO