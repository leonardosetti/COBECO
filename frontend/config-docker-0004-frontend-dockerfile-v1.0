# COBECO Frontend — Dockerfile (nginx + Vanilla JS + CSS do protótipo)
# Sem build de Tailwind: usa CSS estático do protótipo alta fidelidade.

FROM nginx:alpine AS runtime

# Copia configuração nginx
COPY config-nginx-0001-nginx-v1.0.conf /etc/nginx/nginx.conf
COPY config-nginx-0002-nginx-dev-v1.0.conf /etc/nginx/nginx.dev.conf

# Copia fontes estáticas (inclui styles/prototype.css e app.js)
COPY src /usr/share/nginx/html

# Cria usuário não-root e diretórios necessários
RUN adduser -D -H -h /usr/share/nginx/html nginxuser && \
    chown -R nginxuser:nginxuser /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/nginx.conf && \
    mkdir -p /run/nginx && chown nginxuser:nginxuser /run/nginx

USER nginxuser

EXPOSE 80

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/health > /dev/null || exit 0

CMD ["nginx", "-g", "daemon off;"]
