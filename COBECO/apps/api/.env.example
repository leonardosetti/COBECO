# Database
DATABASE_URL=postgresql://cobeco_user:cobeco_dev_password@localhost:5432/cobeco

# JWT
# Obrigatórios em produção: mínimo de 32 caracteres, diferentes entre si e
# distintos dos valores deste arquivo. Gere com: openssl rand -hex 48
# Em desenvolvimento, se ausentes, a API gera segredos efêmeros e avisa no log.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30m

# Server
PORT=3333
NODE_ENV=development

# Email
MAIL_FROM=noreply@cobeco.local
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025

# CORS
CORS_ORIGIN=http://localhost:5173

# Session
SESSION_MAX_AGE_MINUTES=30

# Price integrations
# O MVP usa somente o catálogo persistido; a cotação avulsa usa mock local.
ENABLE_EXTERNAL_PRICE_PROVIDERS=false
# Para selecionar integrações explicitamente: mercado-livre,dummyjson,mock
PRICE_PROVIDERS=

# A busca pública do Mercado Livre foi descontinuada e responde HTTP 403 sem
# credencial. Informe um token OAuth para habilitar a fonte; vazio, ela é
# omitida do registro em vez de falhar a cada consulta.
MERCADO_LIVRE_ACCESS_TOKEN=

# OpenRouter (LLM)
# Preparado para implementação futura; nenhuma rota da API consome ainda.
# Sem OPENROUTER_API_KEY o cliente fica desabilitado em vez de falhar.
# O par de fallback é usado quando o modelo principal responde 429 ou 5xx.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FALLBACK_API_KEY=
