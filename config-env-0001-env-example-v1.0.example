# COBECO — Environment Variables Template
# Copie para .env e preencha os valores (NÃO commite .env)

# ============================================================
# GitHub / MCP
# ============================================================
# GITHUB_TOKEN — Personal Access Token com escopos: repo, project, read:org
# CR_PAT — Container Registry PAT (se usar GHCR)
# Ambos vêm do ambiente do shell ($GITHUB_TOKEN, $CR_PAT)
# O .env apenas referencia; não hardcode valores aqui.

# GitHub MCP servers (github, github-remote, github-kanban)
GITHUB_TOKEN=${GITHUB_TOKEN}
CR_PAT=${CR_PAT}

# ============================================================
# Database (MySQL)
# ============================================================
MYSQL_ROOT_PASSWORD=cobeco_root_2026
MYSQL_DATABASE=cobeco
MYSQL_USER=cobeco
MYSQL_PASSWORD=cobeco_user_2026

# ============================================================
# Backend (FastAPI)
# ============================================================
DATABASE_URL=mysql+pymysql://cobeco:cobeco_user_2026@db:3306/cobeco
SECRET_KEY=changeme-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# Frontend / Proxy
# ============================================================
NGINX_PORT=8380
VITE_API_BASE_URL=http://localhost:8380/api

# ============================================================
# Misc
# ============================================================
TZ=America/Sao_Paulo